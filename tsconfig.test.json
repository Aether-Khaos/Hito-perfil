{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false,
    "outDir": ".pruebas",
    "rootDir": "."
  },
  "include": [
    "lib/escala.ts",
    "lib/texto.ts",
    "lib/catalogo-reactivos.ts",
    "lib/diagnostico.ts",
    "lib/parser-libro.ts"
  ]
}
