# Copia este archivo como .env.local y completa los valores (sin comillas).
# Neon: Dashboard → Connect → "Connection string" (NO copies el prefijo psql).
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Opcional en local (si no existe se usa keys.json). En Vercel pega aquí el JSON completo de la cuenta de servicio.
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}
